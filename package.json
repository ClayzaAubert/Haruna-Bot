{
  "name": "harunabot",
  "version": "4.0.0",
  "description": "Production-grade WhatsApp bot framework",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "db:migrate": "node src/storage/migration.js",
    "db:seed": "node src/storage/seeds/index.js"
  },
  "imports": {
    "#environment/*": "./src/environment/*",
    "#helpers/*": "./src/helpers/*",
    "#storage/*": "./src/storage/*",
    "#storage/models/*": "./src/storage/models/*",
    "#network/*": "./src/network/*",
    "#events/*": "./src/events/*",
    "#messages/*": "./src/messages/*",
    "#commands/*": "./src/commands/*",
    "#commands/modules/*": "./src/commands/modules/*",
    "#guards/*": "./src/guards/*",
    "#features/*": "./src/features/*",
    "#extensions/*": "./src/extensions/*",
    "#boot/*": "./src/boot/*",
    "#tui/*": "./src/tui/*"
  },
  "dependencies": {
    "axios": "^1.7.0",
    "baileys": "latest",
    "better-sqlite3": "^11.0.0",
    "blessed": "^0.1.81",
    "dotenv": "^16.4.0",
    "file-type": "^21.3.2",
    "fluent-ffmpeg": "^2.1.3",
    "node-cache": "^5.1.2",
    "node-webpmux": "^3.2.1",
    "pino": "^9.3.0",
    "pino-pretty": "^11.2.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
