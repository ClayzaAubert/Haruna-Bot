# ─── Bot Identity ─────────────────────────────────────────────────────────────
BOT_NAME=HarunaBot
PREFIX=!

# ─── Owner ────────────────────────────────────────────────────────────────────
OWNER_NUMBER=628xxxxxx

# ─── Login Mode ───────────────────────────────────────────────────────────────
PAIRING_NUMBER=628xxxxxx

# ─── Paths ────────────────────────────────────────────────────────────────────
SESSION_PATH=./sessions
DB_PATH=./data/akanebot.db

# ─── Auth Backend ─────────────────────────────────────────────────────────────
# file   = development (default)
# sqlite = production (lebih efisien)
AUTH_BACKEND=file
SESSION_ID=default

# ─── AI Provider (isi salah satu) ─────────────────────────────────────────────
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini

# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-haiku-4-5

# GROQ_API_KEY=gsk_...          ← Gratis, daftar di console.groq.com
# GROQ_MODEL=llama-3.1-8b-instant

# ─── Logging ──────────────────────────────────────────────────────────────────
# trace | debug | info | warn | error | fatal
LOG_LEVEL=info

# ─── Terminal UI ───────────────────────────────────────────────────────────
# true  = alternate-screen TUI dashboard (blessed)
# false = standard console banner (default)
DASH_TERMINAL=false

# ─── Misc ─────────────────────────────────────────────────────────────────────
TIMEZONE=Asia/Jakarta
RESPOND_TO_SELF=false
NODE_ENV=development
